{
  "name": "@moss-engine/mossjs",
  "version": "0.4.0",
  "description": "Browser/WebAssembly bindings for the Moss game framework",
  "type": "module",
  "types": "./web/moss.d.ts",
  "exports": {
    ".": "./web/moss.js"
  },
  "scripts": {
    "build": "npm run build:wasm",
    "build:wasm": "emcmake cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DMOSSJS_SINGLE_FILE=OFF && cmake --build build --parallel",
    "build:single": "emcmake cmake -S . -B build-single -DCMAKE_BUILD_TYPE=Release -DMOSSJS_SINGLE_FILE=ON && cmake --build build-single --parallel",
    "build:debug": "emcmake cmake -S . -B build-debug -DCMAKE_BUILD_TYPE=Debug -DMOSSJS_ASSERTIONS=ON && cmake --build build-debug --parallel",
    "build:threads": "emcmake cmake -S . -B build-threads -DCMAKE_BUILD_TYPE=Release -DMOSSJS_THREADS=ON && cmake --build build-threads --parallel",
    "serve": "python -m http.server 8080 -d examples"
  },
  "engines": {
    "node": ">=18"
  }
}
