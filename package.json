{
  "name": "@moss-engine/moss-web",
  "version": "0.1.0",
  "description": "WebAssembly/JavaScript bindings for the Moss game framework",
  "type": "module",
  "main": "dist/moss-web.js",
  "module": "dist/moss-web.js",
  "exports": {
    ".": "./dist/moss-web.js"
  },
  "scripts": {
    "build": "emcmake cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build --parallel",
    "build:debug": "emcmake cmake -S . -B build-debug -DCMAKE_BUILD_TYPE=Debug && cmake --build build-debug --parallel",
    "serve": "python -m http.server 8080 -d examples"
  },
  "engines": {
    "node": ">=18"
  }
}
